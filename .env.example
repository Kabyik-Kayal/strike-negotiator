# Strike Negotiator local environment
# Fill values before running the app.

# Required security setting
STRIKE_HASH_SALT=

# Runtime storage (optional overrides)
STRIKE_DATA_DIR=
STRIKE_AUDIO_DIR=
STRIKE_DB_URL=
STRIKE_MAX_AUDIO_BYTES=15728640

# Anthropic (use either key name)
ANTHROPIC_API_KEY=
STRIKE_ANTHROPIC_API_KEY=
STRIKE_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Local Whisper model for audio transcription
# Options: tiny, base, small, medium, large  (base is a good balance of speed/accuracy)
STRIKE_LOCAL_WHISPER_MODEL=base
